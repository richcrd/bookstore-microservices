# Plantilla de secretos para Producción/QA (docker-compose.prod.yml).
#
# Copiar a docker/.env y rellenar ANTES de `up -d --build`:
#   cp docker/.env.prod.example docker/.env
#
# .env está en .gitignore (nunca se comitea). En el CI/CD las mismas variables
# se inyectan como GitHub Secrets (ver .github/workflows/cd.yml, `envs:`): el
# compose las interpola desde la sesión remota sin necesidad de .env en el server.
#
# Valores OBLIGATORIOS (sin default en el compose a propósito: fail-fast si faltan):
POSTGRES_PASSWORD=change-me-strong-password
RABBITMQ_USER=bookstore
RABBITMQ_PASSWORD=change-me-strong-rabpass
CLI_CLIENT_SECRET=change-me-cli-client-secret
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# Opcionales (con default sensible para demo):
# POSTGRES_USER=postgres
# BOOKSTORE_PUBLIC_ISSUER=http://auth:5100   # URL pública del emisor OIDC si hay TLS/reversa
# GRAFANA_ALERT_WEBHOOK_URL=http://host.docker.internal:3001/hooks/none  # webhook real Slack/Teams